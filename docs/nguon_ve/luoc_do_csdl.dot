digraph CSDL {
  rankdir=TB; nodesep=0.6; ranksep=0.9; splines=true;
  fontname="DejaVu Sans"; fontsize=13; labelloc=b;
  label="Lược đồ CSDL quan hệ – nha_sach  (PK: khoá chính, FK: khoá ngoại; đầu chân chim = phía \"nhiều\")";
  node [shape=none, margin=0, fontname="DejaVu Sans", fontsize=11];
  edge [arrowsize=0.9, dir=both, arrowtail=tee, arrowhead=crow];
  nguoi_dung [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>nguoi_dung</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ten_dang_nhap</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50), duy nhất</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">mat_khau_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ho_ten</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">vai_tro</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">KHACH | NHANVIEN | QUANLY | QUANTRI</FONT></TD></TR></TABLE>>];
  quy_dinh [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#f3ead3"><B>quy_dinh</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">ten</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">gia_tri</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">mo_ta</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  the_loai [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>the_loai</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ten</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100), duy nhất</FONT></TD></TR></TABLE>>];
  sach [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>sach</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ma_vach</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(13), duy nhất</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ten</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">the_loai_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → the_loai.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">tac_gia</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">don_gia</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">so_luong_ton</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
  phieu_nhap [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>phieu_nhap</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ngay_nhap</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">nguoi_quan_ly_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → nguoi_dung.id</FONT></TD></TR></TABLE>>];
  chi_tiet_phieu_nhap [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>chi_tiet_phieu_nhap</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT">phieu_nhap_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → phieu_nhap.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT">sach_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → sach.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">so_luong</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR></TABLE>>];
  don_hang [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>don_hang</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">kenh</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ONLINE | QUAY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">khach_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → nguoi_dung.id (có thể NULL)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ten_khach</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>FK</B></TD><TD ALIGN="LEFT">nhan_vien_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → nguoi_dung.id (có thể NULL)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">hinh_thuc_tt</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">TRUC_TIEP | ONLINE</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">trang_thai</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">CHO_LAY | HOAN_TAT | DA_HUY</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">ngay_tao</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">han_lay_sach</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME (có thể NULL)</FONT></TD></TR></TABLE>>];
  chi_tiet_don_hang [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#e3ecf7"><B>chi_tiet_don_hang</B></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT">don_hang_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → don_hang.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"><B>PK,FK</B></TD><TD ALIGN="LEFT">sach_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT → sach.id</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">so_luong</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="38"></TD><TD ALIGN="LEFT">don_gia</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT (giá chốt lúc bán)</FONT></TD></TR></TABLE>>];

  the_loai   -> sach;
  nguoi_dung -> phieu_nhap;
  phieu_nhap -> chi_tiet_phieu_nhap;
  sach       -> chi_tiet_phieu_nhap;
  nguoi_dung -> don_hang;
  don_hang   -> chi_tiet_don_hang;
  sach       -> chi_tiet_don_hang;
}
